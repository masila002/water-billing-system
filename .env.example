# Local dev defaults. Copy to .env (git-ignored) and set POSTGRES_PASSWORD.
POSTGRES_USER=majibill
POSTGRES_PASSWORD=majibill
POSTGRES_DB=majibill
# Host ports: 5434/6381 avoid Griot (5433/6380) and the defaults.
DATABASE_URL=postgres://majibill:majibill@127.0.0.1:5434/majibill
REDIS_URL=redis://127.0.0.1:6381
API_URL=http://127.0.0.1:4000

