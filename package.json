{
  "name": "majibill",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "demo-app/frontend",
    "demo-app/backend",
    "apps/api",
    "apps/web",
    "apps/reader",
    "packages/domain",
    "packages/contracts",
    "packages/ui",
    "packages/config",
    "mcp",
    "ai"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @majibill/demo-frontend -- --host 127.0.0.1",
    "build": "npm run build --workspace @majibill/demo-frontend && npm run build --workspace @majibill/demo-backend",
    "build:production": "npm run build --workspace @majibill/core-api && npm run build --workspace @majibill/domain",
    "preview": "npm run preview --workspace @majibill/demo-frontend -- --host 127.0.0.1",
    "api": "npm run start:dev --workspace @majibill/demo-backend",
    "api:production": "npm run start:dev --workspace @majibill/core-api",
    "db:migrate": "node db/migrate.js",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:infra:down": "docker compose down",
    "dev:api": "npm run start:dev --workspace @majibill/core-api",
    "test": "node --test demo-app/frontend/tests/*.test.js",
    "test:production": "node --test packages/domain/test/*.test.js",
    "test:e2e": "playwright test",
    "test:integration": "npm run test:integration --workspace @majibill/demo-backend",
    "gate:rls": "python3 scripts/check-rls-catalog.py",
    "gate:contracts": "python3 scripts/check-contract-sync.py",
    "gate:inspo": "python3 scripts/check-inspo-isolation.py",
    "gate:secrets": "python3 scripts/check-secret-literals.py",
    "gate:compose": "docker compose config -q",
    "gates": "npm run gate:rls && npm run gate:contracts && npm run gate:inspo && npm run gate:secrets && npm run gate:compose && git diff --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  },
  "engines": {
    "node": ">=22"
  }
}
